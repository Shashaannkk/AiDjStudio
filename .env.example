# AI DJ Studio Environment Configuration Example

# 1. Supabase Backend Infrastructure (Phase 1 & 5)
# Create a free project at https://supabase.com
# Find your project URL and public Anon Key in Project Settings > API:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# 2. Cryptographic Security & JWT Authority (SEC-02)
# Required: 256-bit cryptographic hex string or minimum 32-character secret
JWT_SECRET=your-secure-jwt-signing-secret-minimum-32-characters

# Master Admin API Key for administrative endpoints
ADMIN_KEY=your-secure-random-admin-api-key

# 3. Initial Operator Admin Provisioning (SEC-03)
# Optional: Used by scripts/provision-admin.mjs to seed the initial operator
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=your-secure-initial-admin-password
INITIAL_ADMIN_NAME=Platform Administrator

# 4. Google Cloud OAuth 2.0 Client ID (Web Application)
# Set your Authorized JavaScript origin to http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 5. Google Gemini AI API Key (AI DJ Voice Commentary & Explanations)
# Get a free key at https://aistudio.google.com/
VITE_GEMINI_API_KEY=AIzaSy...
